DirectoryIndex index.html

# The public site is a client-side SPA. REG.ru serves static files through
# Apache, so extensionless links (for example /meropriyatiya) must fall back
# to the application entry point while real assets remain untouched.
RewriteEngine On
RewriteBase /

# API requests are handled by /api/.htaccess and must not fall back to index.html.
RewriteRule ^api/ - [L]

# Serve the editor explicitly; otherwise /admin/ would be swallowed by the
# SPA fallback and show the public homepage instead of the login screen.
RewriteRule ^admin/?$ admin.html [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]
