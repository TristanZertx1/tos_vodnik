Options -Indexes

# Photo and video uploads (up to 60 MB). Applies only when PHP runs as an Apache module.
<IfModule mod_php.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 72M
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 72M
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 72M
</IfModule>

# Internal code and configuration are never served directly.
RewriteEngine On
RewriteRule ^lib/ - [F,L]
RewriteRule ^config(\.test)?\.php$ - [F,L]

# Every API request goes to the single entry point, except real files such as setup.php.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
